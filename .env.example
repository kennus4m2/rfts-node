# Copy this file to .env and fill it in. Never commit .env.
API_HOST=127.0.0.1
API_PORT=3001

# If the hub does NOT remove /games/reach-for-the-stars before forwarding
# to your port, set API_PREFIX=/games/reach-for-the-stars
API_PREFIX=

# Hub Contract: allow CORS from the hub's address only (comma separated)
CORS_ORIGINS=http://localhost

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=reach_for_the_stars
DB_SCHEMA=reach_for_the_stars

JWT_SECRET=
TEAM_NAME=Team 5 (BSCS 3-_)
