{
  "info": {
    "name": "Reach for the Stars API",
    "description": "Hub Contract v1. Run the requests top to bottom: Login saves hostToken, Create session saves code, Join saves playerToken, Next question saves questionId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "username",
      "value": "host1"
    },
    {
      "key": "password",
      "value": "changeme123"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "GET game-info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/game-info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "game-info"
              ]
            }
          }
        },
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Host",
      "item": [
        {
          "name": "POST login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"hostToken\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "POST question-sets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"setId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Space Basics\",\n  \"description\": \"Easy space trivia\",\n  \"subject\": \"Science\",\n  \"grade_level\": \"Grade 7\",\n  \"questions\": [\n    {\n      \"text\": \"Which planet is closest to the Sun?\",\n      \"type\": \"multiple_choice\",\n      \"choices\": [\n        \"Venus\",\n        \"Mercury\",\n        \"Mars\",\n        \"Earth\"\n      ],\n      \"correct_index\": 1,\n      \"time_limit_sec\": 20\n    },\n    {\n      \"text\": \"The Moon is a star.\",\n      \"type\": \"true_false\",\n      \"choices\": [\n        \"True\",\n        \"False\"\n      ],\n      \"correct_index\": 1,\n      \"time_limit_sec\": 15\n    },\n    {\n      \"text\": \"How many planets are in our solar system?\",\n      \"type\": \"multiple_choice\",\n      \"choices\": [\n        \"7\",\n        \"8\",\n        \"9\"\n      ],\n      \"correct_index\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/question-sets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "question-sets"
              ]
            }
          }
        },
        {
          "name": "GET question-sets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/question-sets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "question-sets"
              ]
            }
          }
        },
        {
          "name": "GET question-sets/:id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/question-sets/{{setId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "question-sets",
                "{{setId}}"
              ]
            }
          }
        },
        {
          "name": "PUT question-sets/:id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Space Basics\",\n  \"description\": \"Easy space trivia\",\n  \"subject\": \"Science\",\n  \"grade_level\": \"Grade 7\",\n  \"questions\": [\n    {\n      \"text\": \"Which planet is closest to the Sun?\",\n      \"type\": \"multiple_choice\",\n      \"choices\": [\n        \"Venus\",\n        \"Mercury\",\n        \"Mars\",\n        \"Earth\"\n      ],\n      \"correct_index\": 1,\n      \"time_limit_sec\": 20\n    },\n    {\n      \"text\": \"The Moon is a star.\",\n      \"type\": \"true_false\",\n      \"choices\": [\n        \"True\",\n        \"False\"\n      ],\n      \"correct_index\": 1,\n      \"time_limit_sec\": 15\n    },\n    {\n      \"text\": \"How many planets are in our solar system?\",\n      \"type\": \"multiple_choice\",\n      \"choices\": [\n        \"7\",\n        \"8\",\n        \"9\"\n      ],\n      \"correct_index\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/question-sets/{{setId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "question-sets",
                "{{setId}}"
              ]
            }
          }
        },
        {
          "name": "DELETE question-sets/:id",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/question-sets/{{setId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "question-sets",
                "{{setId}}"
              ]
            }
          }
        },
        {
          "name": "POST sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"code\", pm.response.json().join_code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_set_id\": {{setId}},\n  \"duration_sec\": 300,\n  \"starting_lives\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            }
          }
        },
        {
          "name": "GET sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            }
          }
        },
        {
          "name": "PATCH sessions/:code (start)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"playing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}"
              ]
            }
          }
        },
        {
          "name": "PATCH sessions/:code (end)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ended\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Player",
      "item": [
        {
          "name": "GET sessions/:code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}"
              ]
            }
          }
        },
        {
          "name": "POST join",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"playerToken\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"StarGazer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}",
                "players"
              ]
            }
          }
        },
        {
          "name": "GET players/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}/players/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}",
                "players",
                "me"
              ]
            }
          }
        },
        {
          "name": "GET questions/next",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.question) pm.collectionVariables.set(\"questionId\", j.question.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}/questions/next",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}",
                "questions",
                "next"
              ]
            }
          }
        },
        {
          "name": "POST answers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.chest_offer) pm.collectionVariables.set(\"chestOfferId\", j.chest_offer.chest_offer_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": {{questionId}},\n  \"choice_index\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}/answers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}",
                "answers"
              ]
            }
          }
        },
        {
          "name": "POST chests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{playerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chest_offer_id\": {{chestOfferId}},\n  \"slot_number\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}/chests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}",
                "chests"
              ]
            }
          }
        },
        {
          "name": "GET leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{code}}/leaderboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{code}}",
                "leaderboard"
              ]
            }
          }
        }
      ]
    }
  ]
}